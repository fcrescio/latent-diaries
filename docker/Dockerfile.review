FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PATH=/workspace/.venv/bin:$PATH
WORKDIR /workspace
RUN pip install uv==0.9.24
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY services ./services
RUN uv sync --locked
EXPOSE 8080
CMD ["uvicorn", "services.review_web.app:app", "--host", "0.0.0.0", "--port", "8080"]
