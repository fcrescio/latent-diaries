# One reproducible image for CPU smoke tests, local GPU and Hugging Face Docker Jobs.
# CUDA availability depends on host runtime and PyTorch wheel; validate with 'doctor'.
# A previously verified image from this same Dockerfile can supply the installed
# runtime for source-only rebuilds. The default remains a complete clean build.
ARG WORKER_BASE_IMAGE=python:3.11-slim
FROM ${WORKER_BASE_IMAGE}
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/cache/hf PATH=/workspace/.venv/bin:$PATH
RUN if ! command -v ffmpeg >/dev/null || ! command -v git >/dev/null || \
       ! command -v sox >/dev/null || ! command -v gcc >/dev/null; then \
      apt-get update && apt-get install -y --no-install-recommends \
      ffmpeg libsndfile1 git ca-certificates sox build-essential && \
      rm -rf /var/lib/apt/lists/*; fi
WORKDIR /workspace
RUN if ! command -v uv >/dev/null || [ "$(uv --version)" != "uv 0.9.24" ]; then \
      pip install uv==0.9.24; fi
COPY pyproject.toml uv.lock README.md ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-install-project --extra ml --extra test
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --extra ml --extra test
# Qwen pins Transformers 4; vision requires Transformers 5. Keep separate import
# paths in this same worker image, sharing the already pinned Torch binary stack.
COPY environments/vision /opt/vision
RUN --mount=type=cache,target=/root/.cache/uv uv sync --project /opt/vision --locked && \
    /opt/vision/.venv/bin/python -c "import site; from pathlib import Path; Path(site.getsitepackages()[0], 'worker-stack.pth').write_text('/workspace/.venv/lib/python3.11/site-packages\n/workspace/src\n')"
# Isolated frozen OmniVoice comparator. The primary and vision locks are intact.
# No model weights enter the image. Keep a real pinned checkout for source/API
# verification, independently of uv's installed wheel from the same Git commit.
COPY environments/omnivoice /opt/omnivoice
RUN git clone https://github.com/k2-fsa/OmniVoice.git /opt/omnivoice/upstream && \
    git -C /opt/omnivoice/upstream checkout --detach 08be0b4ccbac3e13e374e86fbfead4b4cac343e2 && \
    uv sync --no-cache --project /opt/omnivoice --locked && \
    /opt/omnivoice/.venv/bin/python -c "import site; from pathlib import Path; Path(site.getsitepackages()[0], 'worker-stack.pth').write_text('/workspace/.venv/lib/python3.11/site-packages\n/workspace/src\n')"
COPY configs ./configs
COPY scripts ./scripts
COPY docs ./docs
COPY tests ./tests
COPY services ./services
CMD ["latent-diaries", "doctor"]
